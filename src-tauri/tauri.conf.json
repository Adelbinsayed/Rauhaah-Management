{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rauhaah Management",
  "version": "1.0.0",
  "identifier": "com.sooktec.rauhaah",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rauhaah Management",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": false,
        "center": true
      },
      {
        "label": "splash",
        "title": "Rauhaah",
        "url": "splash.html",
        "width": 620,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
